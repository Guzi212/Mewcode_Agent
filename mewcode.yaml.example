# MewCode 配置示例：复制为 mewcode.yaml 并填入真实密钥。
# providers 可配置多项；仅一项时启动直接进入对话，多项时启动出现方向键选择列表。
# 六个字段：name / protocol / model / api_key（必填），base_url / thinking（可选）。

# Agent Loop 最大迭代次数；可选，缺失或非法时使用 20。
agent_max_iterations: 20

providers:
  - name: claude-sonnet
    protocol: anthropic
    model: claude-sonnet-4-5
    api_key: "sk-ant-xxxxxxxx"            # 填入你的 Anthropic API Key
    thinking: true                        # 可选，是否开启扩展思考
    # base_url: https://api.anthropic.com # 可选，自定义端点

  - name: gpt
    protocol: openai
    model: gpt-4o
    api_key: "sk-xxxxxxxx"                # 填入你的 OpenAI API Key
    # base_url: https://api.openai.com/v1 # 可选，可指向兼容端点
